[Unit]
Description=MeetKey captive portal redirect
After=network-online.target meetkey-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/gunwoo/meetkey_poc
Environment=MEETKEY_CAPTIVE_PORT=80
Environment=MEETKEY_CAPTIVE_DEFAULT_TARGET=http://10.42.0.1/records
Environment=MEETKEY_CAPTIVE_TARGET_FILE=/home/gunwoo/MeetKey_Recordings/captive_target.txt
Environment=MEETKEY_CAPTIVE_UPSTREAM=http://127.0.0.1:8000
ExecStart=/usr/bin/python3 /home/gunwoo/meetkey_poc/scripts/captive_portal.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
